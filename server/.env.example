# Copy to .env and replace locally. Never commit secrets.
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/maurus
# Generate at least 32 random characters, e.g. openssl rand -hex 32
JWT_SECRET=
# Set true only behind a trusted HTTPS reverse proxy in production.
TRUST_PROXY=false
# Optional absolute path to the built preview/dist directory for single-origin hosting.
# WEB_DIST=/absolute/path/to/preview/dist

# Private PDFs must be stored outside WEB_DIST; required in production.
# PRIVATE_DOCS_DIR=/absolute/path/to/private/project-documents

# Per-instance connection pool size (1–200); budget across all replicas.
MONGO_MAX_POOL_SIZE=20
# Optional JSON access logs: method, route pattern, status, timing and random request ID only.
HTTP_LOGGING=false

# Initial administrator: fill in locally only when running npm run create-admin.
# No default credentials are supplied. Remove these lines after bootstrap.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
